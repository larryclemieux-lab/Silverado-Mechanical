<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Silverado Parts Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#E9EDF0;--surface:#FFFFFF;--ink:#16212B;--muted:#56646F;--line:#C9D1D8;
  --accent:#2E3A94;--accent-ink:#FFFFFF;
  --emergency:#B3261E;--high:#A86400;--normal:#2E3A94;--low:#66737C;--done:#2E7D4F;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0F161C;--surface:#18222B;--ink:#E6ECF1;--muted:#98A6B1;--line:#2C3A46;
    --accent:#5B9BE0;--accent-ink:#0F161C;
    --emergency:#F2766D;--high:#F0A83A;--normal:#5B9BE0;--low:#8E9BA5;--done:#5CC08A;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0F161C;--surface:#18222B;--ink:#E6ECF1;--muted:#98A6B1;--line:#2C3A46;
  --accent:#5B9BE0;--accent-ink:#0F161C;
  --emergency:#F2766D;--high:#F0A83A;--normal:#5B9BE0;--low:#8E9BA5;--done:#5CC08A;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
/* Only vertical scrolling: no sideways scroll, no pinch or double-tap zoom. */
html,body{overflow-x:hidden;touch-action:pan-y}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.45 "Barlow",system-ui,-apple-system,"Segoe UI",sans-serif}
.wrap{max-width:720px;margin:0 auto;padding:20px 16px 110px}
header .logo{max-width:340px;margin-bottom:14px}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) header .logo{background:#E9EDF0;border-radius:8px;padding:10px 14px}}
:root[data-theme="dark"] header .logo{background:#E9EDF0;border-radius:8px;padding:10px 14px}
header .logo img{display:block;width:100%;height:auto}
h1{font:700 40px/1 "Barlow Condensed","Arial Narrow",sans-serif;margin:2px 0 14px;letter-spacing:.01em}
.counts{display:flex;gap:18px;margin-bottom:16px;color:var(--muted);font-size:15px}
.counts b{font:700 22px/1 "Barlow Condensed","Arial Narrow",sans-serif;color:var(--ink);margin-right:4px}
.counts .em b{color:var(--emergency)}
.tools{display:flex;flex-direction:column;gap:10px;margin-bottom:16px}
input,select,textarea{font:inherit;font-size:16px;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:11px 12px;width:100%;min-height:46px}
input:focus-visible,select:focus-visible,textarea:focus-visible,button:focus-visible,.card:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.seg{display:flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--surface)}
.seg button{flex:1 1 auto;border:0;background:none;color:var(--muted);font:600 15px/1.15 "Barlow",sans-serif;padding:8px 6px;min-height:44px;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
#status{color:var(--muted);padding:24px 4px}
.list{display:flex;flex-direction:column;gap:10px}
.card{background:var(--surface);border:1px solid var(--line);border-left:6px solid var(--p);border-radius:6px;padding:12px 14px;cursor:pointer;text-align:left;width:100%;color:inherit;font:inherit}
.card .top{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.job{font:700 20px/1 "Barlow Condensed","Arial Narrow",sans-serif}
.pri{font-weight:600;font-size:14px;color:var(--p)}
.part{font-size:18px;font-weight:600;margin:6px 0 2px}
.addr{color:var(--muted);font-size:15px}
.notes{margin-top:8px;font-size:15px;white-space:pre-wrap}
.photoCount{display:flex;align-items:center;gap:10px;margin-top:10px;font-size:14px;font-weight:600;color:var(--muted)}
.cardThumb{width:64px;height:64px;object-fit:cover;border-radius:6px;background:var(--line);display:block;cursor:pointer}
.photos{margin:0 0 12px;font-weight:600;font-size:14px}
.photos #photosLabel{display:block;margin-bottom:6px}
.photos [hidden]{display:none}
.photoGrid{display:flex;flex-direction:column;gap:10px;margin-bottom:8px}
.photoItem{display:flex;gap:10px;align-items:flex-start}
.photoItem .thumb{flex:0 0 96px;width:96px}
.photoMeta{flex:1;min-width:0}
.history{margin:-4px 0 12px;font-size:14px;font-weight:600}
.history[hidden]{display:none}
.history ul{margin:4px 0 0;padding:0;list-style:none;font-weight:400;color:var(--muted)}
.history li{margin-bottom:2px}
.lastChange{margin-top:8px;font-size:13px;color:var(--muted)}
.posted{font-size:13px;font-weight:600;color:var(--muted);margin-bottom:4px}
.photoComment{min-height:46px;resize:vertical}
.commentText{font-weight:400;font-size:15px;white-space:pre-wrap}
#photoView .posted{margin-top:10px}
.thumb{position:relative;aspect-ratio:1;border-radius:6px;overflow:hidden;background:var(--line)}
.thumb img{width:100%;height:100%;object-fit:cover;display:block;cursor:pointer}
.thumbDel{position:absolute;top:4px;right:4px;width:32px;height:32px;border-radius:50%;border:0;background:rgba(10,16,22,.7);color:#fff;font-size:20px;line-height:1;cursor:pointer}
.thumbDel.confirm{left:4px;width:auto;border-radius:6px;background:var(--emergency);font:700 15px "Barlow",sans-serif}
.cardPhotoBtn{display:block;width:100%;margin-top:12px;min-height:46px;border:2px solid var(--accent);border-radius:8px;background:none;color:var(--accent);font:700 17px "Barlow Condensed","Arial Narrow",sans-serif;cursor:pointer}
.cardPhotoBtn:disabled{opacity:.6}
.photoBtn{width:100%;min-height:46px;border-radius:8px;font:600 16px "Barlow",sans-serif;cursor:pointer}
#photoView{padding:10px;width:min(900px,calc(100% - 20px))}
#photoView img{display:block;width:100%;height:auto;max-height:calc(100vh - 140px);object-fit:contain}
#photoView button{width:100%;min-height:46px;margin-top:10px;border-radius:8px;font:600 16px "Barlow",sans-serif}
.facts{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px;margin-top:10px;font-size:14px}
.facts dt{color:var(--muted)}
.facts dd{margin:0;font-weight:500}
.loc{display:inline-block;margin-top:10px;font-weight:600;font-size:14px;padding:3px 10px;border-radius:999px;border:1px solid var(--line)}
.loc.done{color:var(--done);border-color:var(--done)}
.swipe{position:relative;border-radius:6px;overflow:hidden}
.swipeHint{position:absolute;inset:0;display:none;align-items:center;padding:0 16px;color:#FFFFFF;font:700 18px "Barlow Condensed","Arial Narrow",sans-serif}
.swipeHint.fwd{background:var(--done)}
.swipeHint.back{background:var(--high);justify-content:flex-end;text-align:right}
.swipe.dir-fwd .swipeHint.fwd,.swipe.dir-back .swipeHint.back{display:flex}
.swipe .card{position:relative;touch-action:pan-y;transition:transform .2s ease}
.swipe .card.dragging{transition:none}
@media (prefers-reduced-motion:reduce){.swipe .card{transition:none}}
.addbar{position:fixed;left:0;right:0;bottom:0;padding:12px 16px calc(12px + env(safe-area-inset-bottom,0px));background:linear-gradient(transparent,var(--bg) 35%)}
.primary{display:block;width:100%;max-width:688px;margin:0 auto;border:0;border-radius:8px;background:var(--accent);color:var(--accent-ink);font:700 20px "Barlow Condensed","Arial Narrow",sans-serif;padding:14px;min-height:52px;cursor:pointer}
.primary:disabled{opacity:.45;cursor:not-allowed}
dialog{border:0;border-radius:10px;padding:0;width:min(560px,calc(100% - 20px));max-height:calc(100% - 40px);background:var(--surface);color:var(--ink)}
dialog::backdrop{background:rgba(10,16,22,.55)}
form{padding:18px 18px 16px}
form h2:focus{outline:none}
form h2{font:700 26px/1 "Barlow Condensed","Arial Narrow",sans-serif;margin:0 0 14px}
label{display:block;font-weight:600;font-size:14px;margin:0 0 12px}
label span{display:block;margin-bottom:4px}
.row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px}
.row>label{min-width:0}
/* iPhone date boxes keep a fixed built-in width and spill into the next field;
   drop the built-in styling so they shrink to their column like other boxes. */
input[type="date"]{-webkit-appearance:none;appearance:none;display:block;min-width:0;max-width:100%;min-height:46px;text-align:left}
input[type="date"]::-webkit-date-and-time-value{text-align:left}
.actions{display:flex;gap:10px;margin-top:6px}
.actions button{flex:1;min-height:48px;border-radius:8px;font:600 16px "Barlow",sans-serif;cursor:pointer}
.ghost{background:none;border:1px solid var(--line);color:var(--ink)}
.save{background:var(--accent);color:var(--accent-ink);border:0}
.del{background:none;border:0;color:var(--emergency);font:600 15px "Barlow",sans-serif;margin-top:12px;padding:8px 0;cursor:pointer}
.err{color:var(--emergency);font-weight:600;min-height:1.2em;margin:0 0 8px}
.sortRow{display:flex;align-items:center;gap:10px;margin:0 0 16px;font-weight:600;font-size:15px;color:var(--muted)}
.sortRow label{margin:0;white-space:nowrap}
#sortDir{flex:none;min-height:46px;padding:0 12px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink);font:600 15px "Barlow",sans-serif;cursor:pointer;white-space:nowrap}
.sortRow select{width:auto;flex:1;min-width:0;max-width:260px;color:var(--ink);font-size:16px}
@media (min-width:560px){.tools{flex-direction:row}.tools input{flex:1.4}.tools .seg{flex:1}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="logo"><img src="data:image/png;base64," alt="Silverado Mechanical LLC, an Airtron company"></div>
    <h1>Parts on order</h1>
    <div class="counts"><span><b id="cWait">0</b>waiting</span><span class="em"><b id="cEm">0</b>emergency</span></div>
  </header>
  <div class="tools">
    <input id="q" type="search" placeholder="Search job #, address, part" aria-label="Search">
    <div class="seg" role="group" aria-label="Show">
      <button data-f="active" aria-pressed="true">Waiting</button>
      <button data-f="sched" aria-pressed="false">Needs scheduling</button>
      <button data-f="done" aria-pressed="false">Installed</button>
    </div>
  </div>
  <div class="sortRow"><label for="sort">Sort by</label><select id="sort">
    <option value="priority">Priority</option>
    <option value="scheduled">Scheduled date</option>
    <option value="ordered">Date ordered</option>
    <option value="stage">Where the part is</option>
    <option value="address">Address</option>
  </select><button type="button" id="sortDir">Highest first</button></div>
  <div id="status">Loading parts…</div>
  <div class="list" id="list"></div>
  <input type="file" id="cardPhotoInput" accept="image/*" multiple hidden>
</div>
<div class="addbar"><button class="primary" id="addBtn" disabled>Add a part</button></div>

<dialog id="dlg">
  <form id="form" novalidate>
    <h2 id="formTitle" tabindex="-1" autofocus>Add a part</h2>
    <div class="row">
      <label><span>Job number</span><input name="jobNumber" autocomplete="off"></label>
      <label><span>Priority</span><select name="priority"></select></label>
    </div>
    <label><span>Job address</span><input name="address" list="addrList" autocomplete="off"></label>
    <datalist id="addrList"></datalist>
    <label><span>Part we're waiting on</span><input name="part" autocomplete="off"></label>
    <label><span>Date ordered</span><input name="dateOrdered" type="date"></label>
    <label><span>Where the part is</span><select name="location"></select></label>
    <div class="history" id="historyBox" hidden><span>Status history</span><ul id="historyList"></ul></div>
    <div class="row">
      <label><span>Scheduled for</span><input name="scheduledDate" type="date"></label>
      <label><span>Job duration</span><input name="duration" placeholder="e.g. 4 hrs" autocomplete="off"></label>
    </div>
    <label><span>Notes</span><textarea name="notes" rows="2"></textarea></label>
    <div class="photos"><span id="photosLabel">Photos</span>
      <div class="photoGrid" id="photoGrid"></div>
      <button type="button" class="ghost photoBtn" id="photoBtn" hidden>Add photos</button>
      <input type="file" id="photoInput" accept="image/*" multiple hidden>
    </div>
    <p class="err" id="formErr"></p>
    <div class="actions">
      <button type="button" class="ghost" id="cancelBtn">Cancel</button>
      <button type="submit" class="save" id="saveBtn">Save part</button>
    </div>
    <button type="button" class="del" id="delBtn" hidden>Delete this part</button>
  </form>
</dialog>
<dialog id="photoView"><img id="photoViewImg" alt="Job photo, full size"><div class="posted" id="photoViewPosted"></div><div class="commentText" id="photoViewComment" hidden></div><button type="button" class="ghost" id="photoViewClose">Close</button></dialog>

<script>
const PRIORITIES = ["Emergency", "High", "Normal", "Low"];
const LOCATIONS = ["Quoted", "Ordered", "Las Vegas office", "En route to Mesquite", "Mesquite office", "Needs scheduling", "Scheduled for install", "Installed"];
const DONE = "Installed";
const FIELDS = ["jobNumber", "address", "part", "dateOrdered", "location", "scheduledDate", "duration", "priority", "notes"];


let db = null;
let rows = [];
let loaded = false; // true once the first list of parts has arrived
let filter = "active";
let query = "";
let sortBy = "priority";
let sortReversed = false;
// What each sort direction is called on the button: [normal, reversed].
const SORT_DIR_LABELS = {
  priority: ["Highest first", "Lowest first"],
  scheduled: ["Soonest first", "Latest first"],
  ordered: ["Oldest first", "Newest first"],
  stage: ["Quoted first", "Installed first"],
  address: ["Low to high", "High to low"],
};
let editingId = null;

const $ = (s) => document.querySelector(s);
const form = $("#form");
const dlg = $("#dlg");

function esc(s) {
  return String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}
function fmtDate(d) {
  if (!d) return "Not set";
  const [y, m, day] = d.split("-").map(Number);
  return new Date(y, m - 1, day).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" });
}
function priColor(p) {
  return "var(--" + (PRIORITIES.includes(p) ? p.toLowerCase() : "normal") + ")";
}
function fillSelect(sel, opts) {
  sel.innerHTML = opts.map((o) => `<option>${esc(o)}</option>`).join("");
}
fillSelect(form.priority, PRIORITIES);
form.priority.add(new Option("Not set", ""));
fillSelect(form.location, LOCATIONS);

function setStatus(msg) {
  $("#status").textContent = msg;
  $("#status").hidden = !msg;
}

function render() {
  const waiting = rows.filter((r) => r.location !== DONE);
  $("#cWait").textContent = waiting.length;
  $("#cEm").textContent = waiting.filter((r) => r.priority === "Emergency").length;

  const q = query.trim().toLowerCase();
  let shown = rows.filter((r) =>
    filter === "done" ? r.location === DONE : filter === "sched" ? r.location === "Needs scheduling" : r.location !== DONE
  );
  if (q) {
    shown = shown.filter((r) =>
      [r.jobNumber, r.address, r.part].some((v) => String(v || "").toLowerCase().includes(q))
    );
  }
  const rank = (p) => (PRIORITIES.includes(p) ? PRIORITIES.indexOf(p) : PRIORITIES.length);
  const byPriority = (a, b) => rank(a.priority) - rank(b.priority);
  const byDate = (f) => (a, b) => (a[f] || "9999").localeCompare(b[f] || "9999");
  const stage = (r) => (LOCATIONS.includes(r.location) ? LOCATIONS.indexOf(r.location) : LOCATIONS.indexOf("Ordered") + 0.5);
  // Each sort: a key (null = blank) and how to compare two keys.
  // Blanks always go to the bottom, whichever direction is chosen.
  const keys = {
    priority: [(r) => (PRIORITIES.includes(r.priority) ? rank(r.priority) : null), (x, y) => x - y],
    scheduled: [(r) => r.scheduledDate || null, (x, y) => x.localeCompare(y)],
    ordered: [(r) => r.dateOrdered || null, (x, y) => x.localeCompare(y)],
    stage: [stage, (x, y) => x - y],
    address: [(r) => r.address || null, (x, y) => x.localeCompare(y, undefined, { numeric: true })],
  };
  const [key, cmp] = keys[sortBy];
  const dir = sortReversed ? -1 : 1;
  shown.sort((a, b) => {
    const ka = key(a), kb = key(b);
    if (ka === null || kb === null) {
      if (ka !== kb) return ka === null ? 1 : -1;
    } else {
      const c = cmp(ka, kb);
      if (c) return c * dir;
    }
    return byPriority(a, b) || byDate("scheduledDate")(a, b);
  });
  $("#sortDir").textContent = SORT_DIR_LABELS[sortBy][sortReversed ? 1 : 0];
  ensureNames(shown.map((r) => (r.history || []).length && r.history[r.history.length - 1].by)).then((found) => { if (found) render(); });

  if (!shown.length) {
    setStatus(rows.length ? "No parts match. Clear the search or pick another filter." : "No parts yet. Tap Add a part to log the first one.");
  } else {
    setStatus("");
  }

  $("#list").innerHTML = shown.map((r) => `
    <div class="swipe">${r.location === DONE ? "" : `<span class="swipeHint fwd">Move to ${esc(nextLocation(r.location))}</span>`}${prevLocation(r.location) ? `<span class="swipeHint back">Back to ${esc(prevLocation(r.location))}</span>` : ""}
    <div class="card" role="button" tabindex="0" data-id="${esc(r.id)}" style="--p:${priColor(r.priority)}">
      <div class="top"><span class="job">${r.jobNumber ? "Job " + esc(r.jobNumber) : ""}</span><span class="pri">${esc(r.priority)}</span></div>
      ${r.part ? `<div class="part">${esc(r.part)}</div>` : ""}
      ${r.address ? `<div class="addr">${esc(r.address)}</div>` : ""}
      <dl class="facts">
        <div><dt>Ordered</dt><dd>${esc(fmtDate(r.dateOrdered))}</dd></div>
        <div><dt>Scheduled</dt><dd>${esc(fmtDate(r.scheduledDate))}</dd></div>
        <div><dt>Duration</dt><dd>${esc(r.duration || "Not set")}</dd></div>
      </dl>
      ${r.notes ? `<div class="notes">${esc(r.notes)}</div>` : ""}
      ${(r.history || []).length ? `<div class="lastChange">${esc(statusLine(r.history[r.history.length - 1]))}</div>` : ""}
      ${(r.photos || []).length ? `<div class="photoCount"><img class="cardThumb" src="${esc(photoSrc(normPhotos(r.photos).at(-1).id))}" alt="Latest job photo" data-view-card="${esc(normPhotos(r.photos).at(-1).id)}"><span>${r.photos.length} photo${r.photos.length === 1 ? "" : "s"}</span></div>` : ""}
      <span class="loc${r.location === DONE ? " done" : ""}">${esc(r.location)}</span>
      ${assets ? `<button type="button" class="cardPhotoBtn" data-photo="${esc(r.id)}"${cardUpload && cardUpload.id === r.id && cardUpload.msg.startsWith("Uploading") ? " disabled" : ""}>${esc(cardUpload && cardUpload.id === r.id ? cardUpload.msg : "Add photos")}</button>` : ""}
    </div></div>`).join("");
}

function prevLocation(loc) {
  const i = LOCATIONS.indexOf(loc);
  // Old stages no longer in the list go back to Ordered; the first stage has nowhere to go.
  if (i === -1) return "Ordered";
  return i === 0 ? null : LOCATIONS[i - 1];
}
function nextLocation(loc) {
  const i = LOCATIONS.indexOf(loc);
  // Old stages no longer in the list (e.g. "Back ordered") come after Ordered.
  if (i === -1) return LOCATIONS[LOCATIONS.indexOf("Ordered") + 1];
  return LOCATIONS[Math.min(i + 1, LOCATIONS.length - 1)];
}

// Photos: stored with the artifact's asset storage; each part keeps a
// `photos` array of { id, by, at, comment } (by = poster's user id).
// Older parts may hold plain id strings; normPhotos() handles both.
// Only "Can edit" viewers get `assets`.
let assets = null;
let canWrite = true;
let userApi = null;
let myId = null;
const nameCache = {};

function normPhotos(list) {
  return (Array.isArray(list) ? list : []).map((p) =>
    typeof p === "string" ? { id: p, by: null, at: "", comment: "" }
      : { id: p.id, by: p.by || null, at: p.at || "", comment: p.comment || "" });
}
function fmtStamp(iso) {
  if (!iso) return "";
  return new Date(iso).toLocaleString(undefined, { month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit" });
}
function postedLine(ph) {
  const who = ph.by ? (nameCache[ph.by] || "Someone") : "";
  return [who, fmtStamp(ph.at)].filter(Boolean).join(" · ");
}
// Resolve poster names, then update only the name lines so typing isn't interrupted.
async function resolveNames(photos) {
  if (!userApi) return;
  const ids = [...new Set(photos.map((p) => p.by).filter((id) => id && !(id in nameCache)))];
  if (!ids.length) return;
  const ps = await userApi.profiles(ids);
  for (const id of ids) nameCache[id] = (ps[id] && ps[id].name) || "";
  document.querySelectorAll("[data-posted]").forEach((el) => {
    const ph = formPhotos.find((p) => p.id === el.dataset.posted) || viewing;
    if (ph && ph.id === el.dataset.posted) el.textContent = postedLine(ph);
  });
}
let formPhotos = [];
let unsavedUploads = [];
let savedForm = false;
const MAX_PHOTO_EDGE = 1600;

function photoSrc(id) { return "/_blob/" + id; }

function renderFormPhotos() {
  $("#photoGrid").innerHTML = formPhotos.map((ph) => `
    <div class="photoItem">
      <div class="thumb">
        <img src="${esc(photoSrc(ph.id))}" alt="Job photo" data-view="${esc(ph.id)}">
        ${assets ? (pendingDelPhoto === ph.id
          ? `<button type="button" class="thumbDel confirm" data-del="${esc(ph.id)}">Remove</button>`
          : `<button type="button" class="thumbDel" data-del="${esc(ph.id)}" aria-label="Remove photo">×</button>`) : ""}
      </div>
      <div class="photoMeta">
        <div class="posted" data-posted="${esc(ph.id)}">${esc(postedLine(ph))}</div>
        ${canWrite
          ? `<textarea class="photoComment" data-comment="${esc(ph.id)}" rows="2" placeholder="Add a comment">${esc(ph.comment)}</textarea>`
          : (ph.comment ? `<div class="commentText">${esc(ph.comment)}</div>` : "")}
      </div>
    </div>`).join("");
  resolveNames(formPhotos);
  $("#photosLabel").hidden = !formPhotos.length && !assets;
  $("#photoBtn").hidden = !assets;
}

async function shrinkPhoto(file) {
  try {
    const bmp = await createImageBitmap(file, { imageOrientation: "from-image" });
    const scale = Math.min(1, MAX_PHOTO_EDGE / Math.max(bmp.width, bmp.height));
    const canvas = document.createElement("canvas");
    canvas.width = Math.round(bmp.width * scale);
    canvas.height = Math.round(bmp.height * scale);
    canvas.getContext("2d").drawImage(bmp, 0, 0, canvas.width, canvas.height);
    const blob = await new Promise((res) => canvas.toBlob(res, "image/jpeg", 0.8));
    if (blob) return blob;
  } catch (e) { /* fall through and upload the original */ }
  return file;
}

function photoError(err) {
  const code = err && err.code;
  if (code === "quota_or_state") return "Photo storage is full. Remove old photos to make room.";
  if (code === "too_large") return "That photo is too large to upload.";
  if (code === "unsupported_type") return "That file type isn't supported. Use a JPEG or PNG photo.";
  if (code === "rate_limited") return "Too many uploads at once. Wait a moment and try again.";
  if (code === "not_granted" || code === "capability_disabled" || code === "capability_removed") return "You need Can edit access to add photos.";
  return "Couldn't upload the photo. Check your connection and try again.";
}

async function addPhotos(files) {
  const btn = $("#photoBtn");
  $("#formErr").textContent = "";
  btn.disabled = true;
  const list = [...files];
  for (let i = 0; i < list.length; i++) {
    btn.textContent = `Uploading ${i + 1} of ${list.length}…`;
    try {
      const { id } = await assets.upload(await shrinkPhoto(list[i]));
      formPhotos = [...formPhotos, { id, by: myId, at: new Date().toISOString(), comment: "" }];
      if (editingId) {
        await db.doc("parts/" + editingId).update({ photos: formPhotos, updatedAt: new Date().toISOString() });
      } else {
        unsavedUploads.push(id);
      }
      renderFormPhotos();
    } catch (err) {
      $("#formErr").textContent = photoError(err);
      break;
    }
  }
  btn.disabled = false;
  btn.textContent = "Add photos";
}

// Browser confirm() pop-ups are blocked inside claude.ai, so deletes use tap-twice instead.
let pendingDelPhoto = null;
let pendingDelTimer = null;
async function removePhoto(id) {
  if (pendingDelPhoto !== id) {
    pendingDelPhoto = id;
    clearTimeout(pendingDelTimer);
    pendingDelTimer = setTimeout(() => { pendingDelPhoto = null; renderFormPhotos(); }, 4000);
    return renderFormPhotos();
  }
  pendingDelPhoto = null;
  clearTimeout(pendingDelTimer);
  try {
    formPhotos = formPhotos.filter((p) => p.id !== id);
    if (editingId) await db.doc("parts/" + editingId).update({ photos: formPhotos, updatedAt: new Date().toISOString() });
    unsavedUploads = unsavedUploads.filter((p) => p !== id);
    renderFormPhotos();
    await assets.delete(id);
  } catch (err) {
    $("#formErr").textContent = "Couldn't remove the photo. Check your connection and try again.";
  }
}

// Adding photos straight from a card on the main list.
let cardPhotoPart = null;
let cardUpload = null; // { id, msg } shown on that card's photo button

async function addPhotosToPart(partId, files) {
  const list = [...files];
  let failed = null;
  for (let i = 0; i < list.length; i++) {
    cardUpload = { id: partId, msg: `Uploading ${i + 1} of ${list.length}…` };
    render();
    try {
      const { id } = await assets.upload(await shrinkPhoto(list[i]));
      const row = rows.find((r) => r.id === partId);
      const photos = [...normPhotos(row && row.photos), { id, by: myId, at: new Date().toISOString(), comment: "" }];
      await db.doc("parts/" + partId).update({ photos, updatedAt: new Date().toISOString() });
    } catch (err) {
      failed = photoError(err);
      break;
    }
  }
  cardUpload = failed ? { id: partId, msg: failed } : null;
  render();
  if (failed) setTimeout(() => { if (cardUpload && cardUpload.msg === failed) { cardUpload = null; render(); } }, 5000);
}

// Status history: each part keeps `history`, a list of
// { from, to, by, at } (by = user id of who made the change).
function historyEntry(from, to) {
  return { from: from || "", to, by: myId, at: new Date().toISOString() };
}
function statusLine(h) {
  let line = (h.from ? "Moved to " : "Added as ") + h.to;
  const who = h.by ? (nameCache[h.by] || "Someone") : "";
  if (who) line += " by " + who;
  if (h.at) line += " · " + fmtStamp(h.at);
  return line;
}
// Look up names for any ids not yet known; true if something new was found.
async function ensureNames(ids) {
  if (!userApi) return false;
  const need = [...new Set(ids.filter((id) => id && !(id in nameCache)))];
  if (!need.length) return false;
  const ps = await userApi.profiles(need);
  for (const id of need) nameCache[id] = (ps[id] && ps[id].name) || "";
  return true;
}
function renderFormHistory(row) {
  const hist = (row && Array.isArray(row.history) ? row.history : []).slice().reverse();
  $("#historyList").innerHTML = hist.map((h) => `<li>${esc(statusLine(h))}</li>`).join("");
  $("#historyBox").hidden = !hist.length;
  ensureNames(hist.map((h) => h.by)).then((found) => { if (found && dlg.open) renderFormHistory(row); });
}

function openForm(row) {
  editingId = row ? row.id : null;
  $("#formTitle").textContent = row ? "Edit part" : "Add a part";
  $("#delBtn").hidden = !row;
  confirmDeletePart = false;
  pendingDelPhoto = null;
  $("#delBtn").textContent = "Delete this part";
  $("#formErr").textContent = "";
  fillSelect(form.location, LOCATIONS);
  if (row && row.location && !LOCATIONS.includes(row.location)) form.location.add(new Option(row.location));
  for (const f of FIELDS) form[f].value = row ? row[f] || "" : "";
  if (!row) {
    form.priority.value = "Normal";
    form.location.value = "Ordered";
    form.dateOrdered.value = new Date().toLocaleDateString("en-CA");
  }
  const addrs = [...new Set(rows.map((r) => r.address).filter(Boolean))].sort();
  $("#addrList").innerHTML = addrs.map((a) => `<option value="${esc(a)}"></option>`).join("");
  formPhotos = normPhotos(row && row.photos);
  unsavedUploads = [];
  savedForm = false;
  renderFormPhotos();
  renderFormHistory(row);
  dlg.showModal();
}

async function save(e) {
  e.preventDefault();
  const data = {};
  for (const f of FIELDS) data[f] = form[f].value.trim();
  data.photos = formPhotos;
  if (!data.jobNumber && !data.part && !data.address) {
    $("#formErr").textContent = "Fill in a job number, part, or address.";
    return;
  }
  const now = new Date().toISOString();
  $("#saveBtn").disabled = true;
  try {
    if (editingId) {
      const existing = rows.find((r) => r.id === editingId) || {};
      const history = Array.isArray(existing.history) ? [...existing.history] : [];
      if (existing.location !== data.location) history.push(historyEntry(existing.location, data.location));
      await db.doc("parts/" + editingId).set({ ...data, history, createdAt: existing.createdAt || now, updatedAt: now });
    } else {
      await db.collection("parts").add({ ...data, history: [historyEntry("", data.location)], createdAt: now, updatedAt: now });
    }
    savedForm = true;
    dlg.close();
  } catch (err) {
    $("#formErr").textContent =
      err && err.code === "quota_exceeded" ? "The tracker is full. Delete installed parts to make room." :
      err && err.code === "invalid_argument" ? "You don't have permission to change the tracker. Ask the owner for edit access." :
      "Couldn't save. Check your connection and try again.";
  } finally {
    $("#saveBtn").disabled = false;
  }
}

let confirmDeletePart = false;
async function remove() {
  if (!editingId) return;
  if (!confirmDeletePart) {
    confirmDeletePart = true;
    $("#delBtn").textContent = "Tap again to delete this part";
    return;
  }
  try {
    const photos = formPhotos;
    await db.doc("parts/" + editingId).delete();
    savedForm = true;
    dlg.close();
    if (assets) for (const ph of photos) assets.delete(ph.id).catch(() => {});
  } catch (err) {
    $("#formErr").textContent = "Couldn't delete. Check your connection and try again.";
  }
}

form.addEventListener("submit", save);
$("#cancelBtn").addEventListener("click", () => dlg.close());
dlg.addEventListener("close", () => {
  // Photos uploaded for a new part that was never saved are cleaned up.
  if (!savedForm && assets) for (const id of unsavedUploads) assets.delete(id).catch(() => {});
  unsavedUploads = [];
});
$("#photoBtn").addEventListener("click", () => $("#photoInput").click());
$("#cardPhotoInput").addEventListener("change", (e) => {
  if (e.target.files.length && cardPhotoPart) addPhotosToPart(cardPhotoPart, e.target.files);
  e.target.value = "";
});
$("#photoInput").addEventListener("change", (e) => {
  if (e.target.files.length) addPhotos(e.target.files);
  e.target.value = "";
});
$("#photoGrid").addEventListener("click", (e) => {
  const del = e.target.closest("[data-del]");
  if (del) return removePhoto(del.dataset.del);
  const img = e.target.closest("[data-view]");
  if (img) openViewer(formPhotos.find((p) => p.id === img.dataset.view));
});
// Save a photo's comment when the box loses focus.
$("#photoGrid").addEventListener("change", async (e) => {
  const box = e.target.closest("[data-comment]");
  if (!box) return;
  formPhotos = formPhotos.map((p) => (p.id === box.dataset.comment ? { ...p, comment: box.value.trim() } : p));
  if (!editingId) return; // new part: saved with the part
  try {
    await db.doc("parts/" + editingId).update({ photos: formPhotos, updatedAt: new Date().toISOString() });
  } catch (err) {
    $("#formErr").textContent = "Couldn't save the comment. Check your connection and try again.";
  }
});
let viewing = null;
function openViewer(ph) {
  if (!ph) return;
  viewing = ph;
  $("#photoViewImg").src = photoSrc(ph.id);
  $("#photoViewPosted").dataset.posted = ph.id;
  $("#photoViewPosted").textContent = postedLine(ph);
  $("#photoViewComment").textContent = ph.comment;
  $("#photoViewComment").hidden = !ph.comment;
  $("#photoView").showModal();
  resolveNames([ph]);
}
$("#photoViewClose").addEventListener("click", () => $("#photoView").close());
$("#delBtn").addEventListener("click", remove);
$("#addBtn").addEventListener("click", () => openForm(null));
$("#list").addEventListener("click", (e) => {
  const card = e.target.closest(".card");
  if (!card) return;
  if (justSwiped) { justSwiped = false; return; }
  const thumb = e.target.closest("[data-view-card]");
  if (thumb) {
    const row = rows.find((r) => r.id === card.dataset.id);
    return openViewer(normPhotos(row && row.photos).find((p) => p.id === thumb.dataset.viewCard));
  }
  const photoBtn = e.target.closest("[data-photo]");
  if (photoBtn) {
    if (photoBtn.disabled) return;
    cardPhotoPart = photoBtn.dataset.photo;
    return $("#cardPhotoInput").click();
  }
  openForm(rows.find((r) => r.id === card.dataset.id));
});
let drag = null;
let justSwiped = false;
const SWIPE_DISTANCE = 90;
function startDrag(target, x, y) {
  const card = target.closest(".card");
  justSwiped = false;
  if (!card || target.closest("[data-photo]") || !card.parentElement.querySelector(".swipeHint")) return;
  drag = { card, x, y, dx: 0, active: false, dir: null };
}
function moveDrag(x, y) {
  if (!drag) return false;
  const dx = x - drag.x, dy = y - drag.y;
  if (!drag.active) {
    if (Math.abs(dy) > 12 && Math.abs(dy) > Math.abs(dx)) { drag = null; return false; }
    if (Math.abs(dx) < 12) return false;
    const dir = dx > 0 ? "fwd" : "back";
    if (!drag.card.parentElement.querySelector(".swipeHint." + dir)) return false;
    drag.active = true;
    drag.dir = dir;
    drag.card.parentElement.classList.add("dir-" + dir);
    drag.card.classList.add("dragging");
  }
  drag.dx = drag.dir === "fwd" ? Math.max(0, dx) : Math.min(0, dx);
  drag.card.style.transform = `translateX(${drag.dx}px)`;
  return true;
}
async function endDrag() {
  if (!drag) return;
  const { card, dx, active, dir } = drag;
  drag = null;
  if (!active) return;
  justSwiped = true;
  card.classList.remove("dragging");
  card.style.transform = "";
  setTimeout(() => card.parentElement && card.parentElement.classList.remove("dir-" + dir), 200);
  if (Math.abs(dx) < SWIPE_DISTANCE) return;
  const row = rows.find((r) => r.id === card.dataset.id);
  if (!row) return;
  try {
    const location = dir === "fwd" ? nextLocation(row.location) : prevLocation(row.location);
    const history = [...(Array.isArray(row.history) ? row.history : []), historyEntry(row.location, location)];
    await db.doc("parts/" + row.id).update({ location, history, updatedAt: new Date().toISOString() });
  } catch (err) {
    setStatus("Couldn't move that part. Check your connection and try again.");
  }
}
// Touch: handled with touch events so the page can claim a sideways drag
// (preventDefault) before the browser or app uses it as its own gesture.
// iPhone Safari ignores user-scalable=no for pinch; block its pinch gesture directly.
document.addEventListener("gesturestart", (e) => e.preventDefault());
const list = $("#list");
list.addEventListener("touchstart", (e) => {
  if (e.touches.length === 1) startDrag(e.target, e.touches[0].clientX, e.touches[0].clientY);
}, { passive: true });
list.addEventListener("touchmove", (e) => {
  if (drag && e.touches.length === 1 && moveDrag(e.touches[0].clientX, e.touches[0].clientY)) e.preventDefault();
}, { passive: false });
list.addEventListener("touchend", endDrag);
list.addEventListener("touchcancel", endDrag);
// Mouse: drag with pointer events on desktop.
list.addEventListener("pointerdown", (e) => {
  if (e.pointerType !== "mouse") return;
  startDrag(e.target, e.clientX, e.clientY);
});
list.addEventListener("pointermove", (e) => {
  if (e.pointerType === "mouse" && moveDrag(e.clientX, e.clientY)) drag.card.setPointerCapture(e.pointerId);
});
list.addEventListener("pointerup", (e) => { if (e.pointerType === "mouse") endDrag(); });
$("#list").addEventListener("keydown", (e) => {
  if (e.key === "Enter" && e.target.classList.contains("card")) openForm(rows.find((r) => r.id === e.target.dataset.id));
});
$("#q").addEventListener("input", (e) => { query = e.target.value; render(); });
$("#sort").addEventListener("change", (e) => { sortBy = e.target.value; sortReversed = false; render(); });
$("#sortDir").addEventListener("click", () => { sortReversed = !sortReversed; render(); });
form.jobNumber.addEventListener("input", () => {
  const match = rows.find((r) => r.jobNumber === form.jobNumber.value.trim() && r.address);
  if (match && !form.address.value.trim()) form.address.value = match.address;
});
document.querySelectorAll(".seg button").forEach((b) =>
  b.addEventListener("click", () => {
    filter = b.dataset.f;
    document.querySelectorAll(".seg button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    render();
  })
);

(async () => {
  try {
    db = window.claude && window.claude.use ? await window.claude.use("db") : null;
  } catch (e) {
    db = null;
  }
  if (!db) {
    setStatus("The shared tracker isn't available here. Open it from its claude.ai link while signed in.");
    return;
  }
  claude.use("assets").then((a) => { assets = a; if (loaded) render(); }).catch(() => { assets = null; });
  claude.use("user").then(async (u) => {
    userApi = u;
    myId = u ? await u.id() : null;
    const w = u ? await u.can("data.write") : null;
    canWrite = w !== false; // null = platform didn't say; keep the box and let a refused write decide
    if (loaded) render();
  }).catch(() => {});
  db.collection("parts").onSnapshot(
    (snap) => {
      rows = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
      loaded = true;
      $("#addBtn").disabled = false;
      render();
    },
    () => setStatus("Lost connection to the tracker. Reload the page to reconnect.")
  );
})();
</script>
</body>
</html>
